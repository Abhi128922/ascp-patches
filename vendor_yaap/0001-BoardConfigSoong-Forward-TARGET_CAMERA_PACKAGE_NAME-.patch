Date: Fri, 2 Oct 2026 08:20:09 +0000
Subject: [PATCH 1/2] BoardConfigSoong: Forward TARGET_CAMERA_PACKAGE_NAME to
 camera:package_name

---
 config/BoardConfigSoong.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/config/BoardConfigSoong.mk b/config/BoardConfigSoong.mk
index 1f81ea4..768551a 100644
--- a/config/BoardConfigSoong.mk
+++ b/config/BoardConfigSoong.mk
@@ -103,3 +103,8 @@ endif
 ifneq ($(TARGET_INIT_VENDOR_LIB),)
     $(call soong_config_set,libinit,vendor_init_lib,$(TARGET_INIT_VENDOR_LIB))
 endif
+
+# Camera package name
+ifneq ($(TARGET_CAMERA_PACKAGE_NAME),)
+    $(call soong_config_set,camera,package_name,$(TARGET_CAMERA_PACKAGE_NAME))
+endif
