From 722b69805bb8da96b14f4c1b23ffad9c6c1848d9 Mon Sep 17 00:00:00 2001
From: gaurav-paul9 <paulgaurav9@gmail.com>
Date: Fri, 2 Oct 2026 11:36:48 +0000
Subject: [PATCH] aston: Enable SurfaceFlinger Oplus ADFR and LTPO rates

---
 BoardConfig.mk | 2 ++
 device.mk      | 1 +
 2 files changed, 3 insertions(+)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 5c524a1..4f7c4bd 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -23,6 +23,8 @@ TARGET_CHARGE_RATE_MULTIPLIER := 1000
 
 # Display
 TARGET_SCREEN_DENSITY := 420
+TARGET_SURFACEFLINGER_SUPPORTS_OPLUS_ADFR := true
+TARGET_SURFACEFLINGER_ARR_USE_OPLUS_LTPO_RATES := true
 
 # Kernel
 TARGET_KERNEL_ADDITIONAL_FLAGS += CONFIG_ASTON_DTB=y
diff --git a/device.mk b/device.mk
index 1428079..8ef34f6 100644
--- a/device.mk
+++ b/device.mk
@@ -30,6 +30,7 @@ PRODUCT_SYSTEM_PROPERTIES += \
     sys.brightness.disable_gamma_conversion=true
 
 $(call soong_config_set_bool,surfaceflinger,supports_oplus_adfr,true)
+$(call soong_config_set_bool,surfaceflinger,arr_use_oplus_ltpo_rates,true)
 $(call soong_config_set_bool,qtidisplay,pxlw_hw_iris7,true)
 
 # IR
