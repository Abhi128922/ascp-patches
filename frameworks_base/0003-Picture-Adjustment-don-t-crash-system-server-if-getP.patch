From 7d536ea0bd7effa18db82b8b331a3b4fce2faa0c Mon Sep 17 00:00:00 2001
From: elpaablo <donopwhile1@gmail.com>
Date: Mon, 13 Jul 2026 01:13:49 +0100
Subject: [PATCH 1/3] Picture Adjustment: don't crash system server if
 getPictureAdjustmentRanges fails

---
 .../server/display/PictureAdjustmentController.java        | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/services/core/java/org/lineageos/server/display/PictureAdjustmentController.java b/services/core/java/org/lineageos/server/display/PictureAdjustmentController.java
index 6c6491ef359a..c5abf7679f03 100644
--- a/services/core/java/org/lineageos/server/display/PictureAdjustmentController.java
+++ b/services/core/java/org/lineageos/server/display/PictureAdjustmentController.java
@@ -41,7 +41,12 @@ public class PictureAdjustmentController extends LiveDisplayFeature {
 
         boolean usePA = mHardware.isSupported(LineageHardwareManager.FEATURE_PICTURE_ADJUSTMENT);
         if (usePA) {
-            final List<Range<Float>> r = mHardware.getPictureAdjustmentRanges();
+            List<Range<Float>> r = null;
+            try {
+                r = mHardware.getPictureAdjustmentRanges();
+            } catch (Exception e) {
+                Slog.e(TAG, "Failed to get picture adjustment ranges from HAL", e);
+            }
             if (r != null) {
                 mRanges.addAll(r);
             }
