From 467bcc1f13510b5bb324ea09ae855e487916da2b Mon Sep 17 00:00:00 2001
From: gaurav-paul9 <paulgaurav9@gmail.com>
Date: Sat, 3 Oct 2026 20:20:06 +0000
Subject: [PATCH] sensorservice: OplusFusionExt: check
 persist.ascp.fusion_light alongside persist.alpha.fusion_light

---
 services/sensorservice/OplusFusionExt.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/services/sensorservice/OplusFusionExt.cpp b/services/sensorservice/OplusFusionExt.cpp
index 4a8fae0..479288c 100644
--- a/services/sensorservice/OplusFusionExt.cpp
+++ b/services/sensorservice/OplusFusionExt.cpp
@@ -46,7 +46,8 @@ inline void* callP(void* obj, int idx) {
 } // namespace
 
 void loadOplusFusionSensors(SensorService* service, const sensor_t* list, size_t count) {
-    if (!property_get_bool("persist.alpha.fusion_light", false)) {
+    if (!property_get_bool("persist.ascp.fusion_light", false) &&
+        !property_get_bool("persist.alpha.fusion_light", false)) {
         return;
     }
 
