From 7a78dff48dae29cfcf393ce51aed7cfaa98f3c13 Mon Sep 17 00:00:00 2001
From: gaurav-paul9 <paulgaurav9@gmail.com>
Date: Sat, 10 Oct 2026 15:00:15 +0000
Subject: [PATCH] sepolicy: Allow perspectived as a permissive domain across
 all binary targets

---
 Android.bp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Android.bp b/Android.bp
index 1e48460..9acd83c 100644
--- a/Android.bp
+++ b/Android.bp
@@ -682,6 +682,7 @@ se_policy_binary {
     installable: false, // used only for Treble labeling tests
     permissive_domains_on_user_builds: [
         "backuptool",
+        "perspectived",
         "su",
     ],
 }
@@ -815,7 +816,10 @@ se_policy_binary {
     dist: {
         targets: ["sepolicy_finalize"],
     },
-    permissive_domains_on_user_builds: ["su"],
+    permissive_domains_on_user_builds: [
+        "perspectived",
+        "su",
+    ],
 }
 
 se_policy_conf {
-- 
2.43.0

